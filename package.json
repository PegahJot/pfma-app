{
  "name": "pfma-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite build && echo Build complete! Deploy the 'dist' folder to your hosting service.",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mobile": "vite preview --host 0.0.0.0",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir dist",
    "deploy:vercel": "npm run build && npx vercel --prod ./dist"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "crypto-js": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/crypto-js": "^4.2.2",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9"
  }
}
